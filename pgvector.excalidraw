    {
      "id": "86w14W3sOY8wUOkRxlGwJ",
      "type": "text",
      "x": 416.10904896284455,
      "y": -311.57390263264415,
      "width": 227.75990295410156,
      "height": 120,
      "angle": 0,
      "strokeColor": "#f08c00",
