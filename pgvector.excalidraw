    },
    {
      "id": "7GGifUVSq036RHkKHwTJF",
      "type": "text",
      "x": 2414.998248019345,
      "y": -63.17628615191336,
      "width": 881.5997314453125,
      "height": 639.5145804894929,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
      "roundness": null,
      "seed": 1309939102,
      "version": 271,
      "versionNonce": 386200317,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1770475962957,
      "link": null,
      "locked": false,
      "text": "engram_vocab_size = [129280*5, 129280*5]  # = [646,400, 646,400]\nmax_ngram_size = 3                          # 支持 2-gram 和 3-gram\nn_embed_per_ngram = 512\nn_head_per_ngram = 8\nn_embed_per_head = n_embed_per_ngram / n_head_per_ngram = 512 / 8 = 64\n\nper Layer:\n  ngram_types = 2 (2-gram, 3-gram)\n  heads_per_ngram = 8\n  \n  list_of_N = [\n    646400, 646400, 646400, 646400, 646400, 646400, 646400, 646400,  # 2-gram 的 8 个头\n    646400, 646400, 646400, 646400, 646400, 646400, 646400, 646400   # 3-gram 的 8 个头\n  ]\n  \n  总头数 = 16\n# 第 456 行\ntotal_N = sum(list_of_N) = 646,400 × 16 = 10,342,400\n\n单层嵌入表参数量\n# 第 457 行\nself.embedding = nn.Embedding(num_embeddings=total_N, embedding_dim=D)\n\n参数量 = total_N × D\n       = 10,342,400 × 64 # (512 // 8)\n       = 661,913,600 参数\n       ≈ 662M 参数 * datatype",
      "fontSize": 18.94858016265164,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "engram_vocab_size = [129280*5, 129280*5]  # = [646,400, 646,400]\nmax_ngram_size = 3                          # 支持 2-gram 和 3-gram\nn_embed_per_ngram = 512\nn_head_per_ngram = 8\nn_embed_per_head = n_embed_per_ngram / n_head_per_ngram = 512 / 8 = 64\n\nper Layer:\n  ngram_types = 2 (2-gram, 3-gram)\n  heads_per_ngram = 8\n  \n  list_of_N = [\n    646400, 646400, 646400, 646400, 646400, 646400, 646400, 646400,  # 2-gram 的 8 个头\n    646400, 646400, 646400, 646400, 646400, 646400, 646400, 646400   # 3-gram 的 8 个头\n  ]\n  \n  总头数 = 16\n# 第 456 行\ntotal_N = sum(list_of_N) = 646,400 × 16 = 10,342,400\n\n单层嵌入表参数量\n# 第 457 行\nself.embedding = nn.Embedding(num_embeddings=total_N, embedding_dim=D)\n\n参数量 = total_N × D\n       = 10,342,400 × 64 # (512 // 8)\n       = 661,913,600 参数\n       ≈ 662M 参数 * datatype",
      "autoResize": true,
      "lineHeight": 1.25
    },
