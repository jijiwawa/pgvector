      "isDeleted": true,
      "boundElements": [],
      "updated": 1770475962956,
      "link": null,
      "locked": false,
      "text": "kvcache数据量\nnum_hidden_layers*seq_len*num_key_value_heads*head_dim*2(k+v)*data_type\nds v3\nnum_hidden_layers = 61层\nseq_len = 2048（2k为例，最大支持128K）\nnum_key_value_heads = 128\nhead_dim = 128\ndata_type = bf16(2B)\n>>> 61*2048*128*128*2*2 /1024/1024/1024\n7.625 GB",
      "fontSize": 20.836638910743957,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "kvcache数据量\nnum_hidden_layers*seq_len*num_key_value_heads*head_dim*2(k+v)*data_type\nds v3\nnum_hidden_layers = 61层\nseq_len = 2048（2k为例，最大支持128K）\nnum_key_value_heads = 128\nhead_dim = 128\ndata_type = bf16(2B)\n>>> 61*2048*128*128*2*2 /1024/1024/1024\n7.625 GB",
      "autoResize": false,
      "lineHeight": 1.25
    },
